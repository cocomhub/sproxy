#!/bin/sh
set -e

# ═══════════════════════════════════════════════════════════════════════════════
# pre-commit：多 go module 硬门禁
#
# 覆盖全部 SUB_MODULE_DIRS（根 module + cmd/sproxy + cmd/sclient + 全部 ext 子
# module，web/e2e 除外——其专属门禁为 make web-test）。执行顺序：
#   0. make fmt-all（go fix + addlicense + gofmt，全部 module）——并自动 re-stage
#   1. go vet（root）+ 子 module vet（如果快速可达）
#   2. gofmt -l 检查（root + 全部子 module）
#   3. check-loopback（测试监听地址必须 127.0.0.1）
#   4. golangci-lint（root，快速检查）+ lint-all（全部子 module，可选）
#
# 绝对禁止用 --no-verify 绕过（2026-09-18 用户明示硬规则）：CI 的 Lint job 有
# 等价的硬门禁（check-format + lint-all），绕过 hook 也会在 CI 被拦。
# ═══════════════════════════════════════════════════════════════════════════════

echo "=== pre-commit 检查 ==="
TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL"

# SUB_MODULE_DIRS 与 Makefile 保持同一份（find go.mod -not web/e2e）
# 注意：.worktrees/* 必须排除（他人/并行开发的 worktree 含未完成 go.mod 子 module，
# 遍历会卡在它们的 golangci-lint / fmt-all——与 Makefile 的 SUB_MODULE_DIRS 同步）。
SUB_MODULE_DIRS=$(find . -name 'go.mod' \
  -not -path './build/*' \
  -not -path './.claude/*' \
  -not -path './.worktrees/*' \
  -not -path './vendor/*' \
  -not -path './web/e2e/*' \
  -exec dirname {} \; | sort -u | grep -v '^\.$')

# 0. make fmt-all（go fix + addlicense + gofmt，全部 module）
echo "[0/5] make fmt-all (go fix + addlicense + gofmt, all modules)..."
make fmt-all 2>&1 || { echo "make fmt-all 失败"; exit 1; }

# 将格式化工具（addlicense / go fix / gofmt）修改过的【全部】文件重新 stage
# （不只 STAGED_FILES：go fix 可能改未 staged 的新文件——2026-09-18 教训）
git add -u 2>/dev/null || true
git ls-files --others --exclude-standard | xargs git add 2>/dev/null || true

# 1. go vet（root）
echo "[1/5] go vet (root)..."
go vet ./... 2>&1 || { echo "go vet 失败"; exit 1; }

# 2. gofmt 检查（确保没有未格式化的文件，全部 module）
echo "[2/5] gofmt (all modules)..."
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "未格式化的文件:"
  echo "$unformatted"
  echo "请运行: gofmt -w <file> 或 make fmt-all"
  exit 1
fi
for dir in $SUB_MODULE_DIRS; do
  unformatted_sub=$(cd "$dir" && gofmt -l .)
  if [ -n "$unformatted_sub" ]; then
    echo "未格式化的文件（$dir）:"
    echo "$unformatted_sub"
    exit 1
  fi
done

# 3. 检查测试监听地址（Windows 防火墙合规：必须绑定 127.0.0.1）
echo "[3/5] check-loopback..."
# 捕获测试文件中显式绑定非 127.0.0.1 / [::1] 回环的监听模式：
#   - net.Listen("tcp[0-9]*", "<host>:port") 且 host 非 127.0.0.1 / [::1]
#     （覆盖 tcp/tcp4/tcp6 变体、空 host 绑所有接口、私网任意首字符）
#   - ListenAndServe() / ListenAndServeTLS()（无地址 → 默认绑所有接口）
# 排除 httptest.NewServer（默认绑定 127.0.0.1）与纯 Dial（非监听）；
# 回环 host（127.0.0.1 / [::1]）显式放行，不触发防火墙弹窗。
found=$(grep -rn --include='*_test.go' \
  -e 'net\.Listen("tcp[0-9]*", *"[^"]*"' \
  -e 'Listen.*0\.0\.0\.0' \
  -e 'Listen.*localhost' \
  -e 'httptest.*0\.0\.0\.0' \
  -e 'ListenAndServe()' \
  -e 'ListenAndServeTLS()' \
  . 2>/dev/null | grep -v '/.claude/' \
  | grep -vE 'net\.Listen\("tcp[0-9]*", *"127\.0\.0\.1(:[0-9]*)?"' \
  | grep -vE 'net\.Listen\("tcp[0-9]*", *"\[::1\](:[0-9]*)?"' \
  || true)
if [ -n "$found" ]; then
  echo "FAIL: 测试文件中发现非 127.0.0.1 监听地址（会触发 Windows 防火墙授权弹窗）:"
  echo "$found"
  echo "所有测试监听必须使用 127.0.0.1:0（httptest.NewServer 默认即回环）。"
  exit 1
fi
echo "loopback 检查通过"

# 4. golangci-lint（root + 全部子 module）
echo "[4/5] lint (root + sub-modules)..."
if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run --timeout=5m ./... 2>&1 || { echo "golangci-lint 失败，请修复代码"; exit 1; }
  echo "golangci-lint (root) OK"
else
  echo "golangci-lint 未安装，跳过 root lint（CI 会兜底）"
fi
for dir in $SUB_MODULE_DIRS; do
  if command -v golangci-lint >/dev/null 2>&1; then
    echo "golangci-lint ($dir)..."
    (cd "$dir" && golangci-lint run --timeout=5m ./...) || { echo "golangci-lint ($dir) 失败"; exit 1; }
  fi
done
echo "lint 全部通过"

echo "=== pre-commit 通过 ==="
echo "（格式化文件已自动加入本次 commit）"

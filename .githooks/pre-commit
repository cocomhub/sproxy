#!/bin/sh
set -e

# ═══════════════════════════════════════════════════════════════════════════════
# pre-commit：轻量增量检查（只检查本次 commit 涉及的文件）
#
# 与原全量硬门禁的关系（2026-10-02 用户明示）：
#   - 本 hook 只对 `git diff --cached` 涉及的文件做快速检查（gofmt / SPDX /
#     go vet / golangci-lint / check-loopback），秒级完成；
#   - 全量重操作（fmt-all / lint-all / vet / check-loopback / notest / archcheck
#     / deadcode 等）不再由 hook 每次跑，统一保留为 make 指令供人工全量检查：
#        make check-ci      # 全量 CI 等价门禁（CI 的 Lint/Test job 仍全量跑）
#        make fmt-all       # go fix + addlicense + gofmt 全部 module
#        make lint-all      # golangci-lint 全部子 module
#   - 仍绝对禁止用 --no-verify 绕过（CI 有等价硬门禁兜底，绕过只推迟不豁免）。
#
# 输出落盘：build/hooks/pre-commit.log（失败后直接查看该日志定位，无需重跑）。
# ═══════════════════════════════════════════════════════════════════════════════

echo "=== pre-commit 检查（增量：仅本次 commit 涉及文件）==="
TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL"

# 日志落盘：build/hooks/<hook>.log（build/ 为 git 忽略产物目录，与 coverage 同级）
LOG_DIR="$TOPLEVEL/build/hooks"
LOG_FILE="$LOG_DIR/pre-commit.log"
mkdir -p "$LOG_DIR"
: > "$LOG_FILE"
say() { printf '%s\n' "$*" | tee -a "$LOG_FILE"; }

say ""
say "=== pre-commit 检查（增量：仅本次 commit 涉及文件）==="
say "日志位置: $LOG_FILE"
say ""

# 本次 staged 的 go 文件（仓库 Go 文件名均为 snake_case、不含空格，按行拆分安全）。
GO_FILES=$(git diff --cached --name-only -- '*.go' 2>/dev/null || true)
# 本次 staged 的**其它文本源码**（加 license 头的常见扩展；按 .gitattributes 文本二进制分界）：
# addlicense 只对已知扩展注入（.go/.js/.ts/.sh/.py/.yaml/.yml/.html/.css/.proto 等，源码
# main.go:294-377 的 fileExtension 白名单），扩展名未知的文件它直接跳过（lic==nil）。
OTHER_FILES=$(git diff --cached --name-only -- \
  '*.js' '*.mjs' '*.cjs' '*.jsx' '*.ts' '*.tsx' '*.py' '*.sh' '*.bash' '*.zsh' \
  '*.yaml' '*.yml' '*.toml' '*.proto' '*.html' '*.htm' '*.css' '*.scss' '*.less' 2>/dev/null || true)

if [ -z "$GO_FILES" ] && [ -z "$OTHER_FILES" ]; then
  say "（本次 commit 无 go/源码文件变更，跳过增量检查）"
  exit 0
fi

# 文件所属 module 根（相对路径；向上找 go.mod，找不到视为根 module "."）
find_mod_root() {
  d=$1
  while [ "$d" != "." ] && [ "$d" != "/" ]; do
    if [ -f "$d/go.mod" ]; then
      echo "$d"
      return
    fi
    d=$(dirname "$d")
  done
  echo "."
}

# 1. gofmt -l 检查：只查涉及文件
say "[1/5] gofmt -l（涉及文件）..."
unformatted=""
for f in $GO_FILES; do
  [ -f "$f" ] || continue
  if [ -n "$(gofmt -l "$f" 2>/dev/null)" ]; then
    unformatted="$unformatted
$f"
  fi
done
if [ -n "$unformatted" ]; then
  say "未格式化的文件:"
  say "$unformatted"
  say "请运行: gofmt -w <file> 或 make fmt-all（全量格式化后重 stage）"
  exit 1
fi

# 2. SPDX 头检查：只查涉及文件（新增/修改均应携带 Apache-2.0 头）
#    **增量**：addlicense 只对本次 commit 涉及文件跑（`-check` 不修改文件）——全仓扫描
#    （Windows 上 ~4-8s）交 CI 的 check-format 兼底；本地 hook 只保「本次改动合规」。
say "[2/5] SPDX 头（涉及 go + 源码文件，增量 addlicense -check）..."
missing_spdx=""
ALL_FILES=$(printf '%s
%s' "$GO_FILES" "$OTHER_FILES" | grep -v '^$' | sort -u)
for f in $ALL_FILES; do
  [ -f "$f" ] || continue
  # 忽略清单与 make addlicense 一致（vendor / 本地配置）。
  case "$f" in
    web/static/vendor/*|.claude/*|.trae/*|.cursor/*) continue ;;
  esac
  if ! head -3 "$f" 2>/dev/null | grep -q "SPDX-License-Identifier"; then
    missing_spdx="$missing_spdx
$f"
  fi
done
# 对涉及文件跑 addlicense -check（单文件级，避免全仓递归扫描）。
# 注：addlicense 的 hasLicense 判定是「出现 SPDX-License-Identifier（任意值）即视为已有头」
# （源码 main.go:432-434：bytes.Contains(… "spdx-license-identifier")）⇒ 值写错不会被抓，
# 但「完全无头」必被报（rc=1 + 文件名列表）；头值校验已有上方 SPDX 行存在性检查兜底。
if [ -n "$ALL_FILES" ]; then
  if ! addlicense_out=$(addlicense -check -c "The Cocomhub Authors. All rights reserved." -s=only $ALL_FILES 2>&1); then
    say "addlicense -check 失败（涉及文件）:"
    say "$addlicense_out"
    missing_spdx="$missing_spdx
（addlicense -check 报告见上）"
  fi
fi
if [ -n "$missing_spdx" ]; then
  say "缺少 SPDX 头 / addlicense 检查未通过的文件:"
  say "$missing_spdx"
  say "请运行: addlicense -c \"The Cocomhub Authors. All rights reserved.\" -s=only <file> 修复后重新 git add"
  exit 1
fi

# 3. go vet：只 vet 涉及文件所属的包（按文件所在目录去重，cd 到所属 module 跑）
say "[3/5] go vet（涉及文件所属包）..."
vet_failed=0
VET_DONE=""
for f in $GO_FILES; do
  [ -f "$f" ] || continue
  dir=$(dirname "$f")
  mod_root=$(find_mod_root "$dir")
  # 相对 module 根的包路径（module 根自身 → "."）
  if [ "$dir" = "$mod_root" ]; then
    rel="."
  else
    rel="${dir#"$mod_root"/}"
  fi
  key="$mod_root|$rel"
  case " $VET_DONE " in
    *" $key "*) continue ;;
  esac
  VET_DONE="$VET_DONE $key"
  # if 结构内的命令失败不触发 set -e：vet 失败需继续执行错误捕获与日志落盘
  # （set -e 下赋值式 $(...) 会在 vet rc≠0 时静默退出，吞掉后续 say 输出——2026-10-02 修复）。
  # 全 e2e 门控包（如 test/，全部文件带 //go:build e2e）无 tag 时 go vet 报
  # "build constraints exclude all Go files"——回落 -tags=e2e 真实分析（2026-10-03 补）。
  if ! vet_out=$(cd "$mod_root" && go vet "./$rel" 2>&1); then
    if echo "$vet_out" | grep -q "build constraints exclude all Go files"; then
      if vet_out=$(cd "$mod_root" && go vet -tags=e2e "./$rel" 2>&1); then
        say "go vet -tags=e2e 通过（全 e2e 门控包）: $mod_root/$rel"
      else
        say "go vet 失败: $mod_root/$rel"
        say "$vet_out"
        vet_failed=1
      fi
    else
      say "go vet 失败: $mod_root/$rel"
      say "$vet_out"
      vet_failed=1
    fi
  fi
done
if [ "$vet_failed" -ne 0 ]; then
  exit 1
fi

# 4. golangci-lint：只 lint 涉及文件（按 module 分组，目录级运行）
say "[4/5] golangci-lint（涉及文件所属包）..."
if command -v golangci-lint >/dev/null 2>&1; then
  export GOLANGCI_LINT_CACHE="$TOPLEVEL/.cache/golangci"
  lint_failed=0
  LINT_DONE=""
  for f in $GO_FILES; do
    [ -f "$f" ] || continue
    dir=$(dirname "$f")
    mod_root=$(find_mod_root "$dir")
    if [ "$dir" = "$mod_root" ]; then
      rel="."
    else
      rel="${dir#"$mod_root"/}"
    fi
    key="$mod_root|$rel"
    case " $LINT_DONE " in
      *" $key "*) continue ;;
    esac
    LINT_DONE="$LINT_DONE $key"
    # 同 go vet：if 结构规避 set -e，lint 失败时错误捕获与日志落盘须继续执行。
    # 全 e2e 门控包（如 test/）无 tag 时 golangci-lint 无可分析文件——回落 -tags=e2e
    # （2026-10-03 补，与 vet 分支同源）。
    if ! lint_out=$(cd "$mod_root" && golangci-lint run --timeout=5m --allow-parallel-runners "./$rel" 2>&1); then
      if echo "$lint_out" | grep -q "build constraints exclude all Go files\|no packages to analyze\|no Go files"; then
        if lint_out=$(cd "$mod_root" && golangci-lint run --timeout=5m --allow-parallel-runners --build-tags=e2e "./$rel" 2>&1); then
          say "golangci-lint -tags=e2e 通过（全 e2e 门控包）: $mod_root/$rel"
        else
          say "golangci-lint 失败: $mod_root/$rel"
          say "$lint_out"
          lint_failed=1
        fi
      else
        say "golangci-lint 失败: $mod_root/$rel"
        say "$lint_out"
        lint_failed=1
      fi
    fi
  done
  if [ "$lint_failed" -ne 0 ]; then
    exit 1
  fi
else
  say "golangci-lint 未安装，跳过 lint（CI 会兜底）"
fi

# 5. check-loopback：只检查本次涉及测试文件的监听地址（Windows 防火墙合规）
say "[5/5] check-loopback（涉及测试文件）..."
test_files=$(printf '%s\n' "$GO_FILES" | grep '_test\.go$' || true)
if [ -n "$test_files" ]; then
  found=""
  for tf in $test_files; do
    [ -f "$tf" ] || continue
    m=$(grep -n \
      -e 'net\.Listen("tcp[0-9]*", *"[^"]*"' \
      -e 'Listen.*0\.0\.0\.0' \
      -e 'Listen.*localhost' \
      -e 'httptest.*0\.0\.0\.0' \
      -e 'ListenAndServe()' \
      -e 'ListenAndServeTLS()' \
      "$tf" 2>/dev/null \
      | grep -vE 'net\.Listen\("tcp[0-9]*", *"127\.0\.0\.1(:[0-9]*)?"' \
      | grep -vE 'net\.Listen\("tcp[0-9]*", *"\[::1\](:[0-9]*)?"' || true)
    [ -n "$m" ] && found="$found
$m"
  done
  if [ -n "$found" ]; then
    say "FAIL: 本次涉及测试文件中发现非 127.0.0.1 监听地址（会触发 Windows 防火墙授权弹窗）:"
    say "$found"
    say "所有测试监听必须使用 127.0.0.1:0（httptest.NewServer 默认即回环）。"
    exit 1
  fi
fi
say "loopback 检查通过（涉及文件）"

say ""
say "=== pre-commit 通过（增量） ==="
say "（如需全量检查: make check-ci / make fmt-all / make lint-all）"
say "（日志: $LOG_FILE）"

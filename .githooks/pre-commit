#!/bin/sh
set -e

echo "=== pre-commit 检查 ==="

# 记录当前已 staged 的文件列表，用于后续只重新 stage 格式化过的文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# 0. make build（编译验证 + 格式化）
echo "[0/4] make build..."
cd "$(git rev-parse --show-toplevel)"
make build 2>&1 || { echo "make build 失败"; exit 1; }

# 将格式化工具（addlicense / go fix / gofmt）修改过的文件重新 stage
# 这样格式化变更会自动包含在当前 commit 中，无需二次 commit
if [ -n "$STAGED_FILES" ]; then
  echo "$STAGED_FILES" | xargs git add 2>/dev/null || true
fi

# 1. go vet
echo "[1/4] go vet..."
go vet ./... 2>&1

# 2. gofmt 检查（确保没有未格式化的文件）
echo "[2/4] gofmt..."
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo "未格式化的文件:"
  echo "$unformatted"
  echo "请运行: gofmt -w <file>"
  exit 1
fi

# 3. 检查测试监听地址
echo "[3/4] check-loopback..."
found=$(grep -rn --include='*_test.go' 'Listen.*0\.0\.0\.0\|Listen.*localhost\|httptest.*0\.0\.0\.0\|\"localhost\"' . 2>/dev/null || true)
if [ -n "$found" ]; then
  echo "警告: 测试文件中发现 localhost/0.0.0.0 监听地址（应使用 127.0.0.1）:"
  echo "$found"
  exit 1
fi

# 4. golangci-lint（快速检查）
echo "[4/4] lint..."
if command -v golangci-lint >/dev/null 2>&1; then
  golangci-lint run ./... 2>&1 || { echo "golangci-lint 失败，请修复代码"; exit 1; }
fi

echo "=== pre-commit 通过 ==="
echo "（格式化文件已自动加入本次 commit）"

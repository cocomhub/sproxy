#!/bin/sh
set -e

# ═══════════════════════════════════════════════════════════════════════════════
# pre-push：push 前全量硬门禁（2026-10-02 用户明示）
#
# 保证 push 前跑通：make fmt-all（全量格式化）→ make lint-all（全部子 module
# lint）→ make check-ci（全量 CI 等价门禁：vet/lint/check-loopback/notest/
# archcheck/deadcode/build/test-cover/cover-check/test-all/build-all）。
#
# 与 pre-commit（增量轻量检查）互补：pre-commit 秒级兜本地，pre-push 全量兜
# push。CI 仍会再跑等价门禁（Lint/Test job），pre-push 只是前置减速带，不是
# 豁免依据；绝对禁止用 --no-verify 绕过（绕过只推迟到 CI，不豁免）。
#
# 输出落盘：build/hooks/pre-push.log（任一 make 失败时直接查看该日志定位，
# 无需重新 push 或手动重跑命令）。
#
# 注：只对分支推送（refs/heads/*）触发；tag 推送不跑全量（tag 无工作树变更）。
# 场景分类（2026-10-02 用户明示补充）：
#   - tag / 分支删除 / 无 stdin：跳过全量；
#   - 分支推送（含 go 文件变更）：跑 fmt-all → lint-all → check-ci 全量；
#   - 分支推送（无 go 文件变更，纯 docs/config/CI）：跳过全量（与 pre-commit 的
#     「无 go 文件快速放行」一致；此类 push 的 CI 通常走 docs-only 通道）；
#   - 新分支首次 push（remote sha=全零）：base 取 merge-base(origin/master, local)，
#     无法判定时保守跑全量（宁可多跑，不 miss 检查）。
# ═══════════════════════════════════════════════════════════════════════════════

# pre-push 的 stdin 为：<local ref> <local sha> <remote ref> <remote sha>，一行一推送。
# 收集推送对：分支推送记录 local/remote sha；tag/删除跳过。
BRANCH_PUSH=0
PUSH_PAIRS=""
while IFS= read -r line; do
  [ -z "$line" ] && continue
  local_ref=$(echo "$line" | awk '{print $1}')
  local_sha=$(echo "$line" | awk '{print $2}')
  remote_sha=$(echo "$line" | awk '{print $4}')
  case "$local_ref" in
    refs/heads/*)
      # 分支删除推送（local sha 全零）不算真正分支推送
      case "$local_sha" in
        0000000000000000000000000000000000000000) : ;;
        *) BRANCH_PUSH=1; PUSH_PAIRS="$PUSH_PAIRS $local_sha|$remote_sha" ;;
      esac
      ;;
    *) : ;;
  esac
done

if [ "$BRANCH_PUSH" -ne 1 ]; then
  echo "=== pre-push：本次仅 tag/删除/非分支推送，跳过全量门禁 ==="
  exit 0
fi

echo "=== pre-push 检查（分支推送）==="
TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL"

# golangci-lint 缓存隔离：与 pre-commit 一致，防止并行 worktree 各自 lint 时抢
# 全局缓存锁（"parallel golangci-lint is running" 误拦主仓 push，2026-09-29 同型修复）。
export GOLANGCI_LINT_CACHE="$TOPLEVEL/.cache/golangci"

# 日志落盘：build/hooks/<hook>.log（build/ 为 git 忽略产物目录，与 coverage 同级）
LOG_DIR="$TOPLEVEL/build/hooks"
LOG_FILE="$LOG_DIR/pre-push.log"
mkdir -p "$LOG_DIR"
: > "$LOG_FILE"
# say：实时显示 + 落盘
say() { printf '%s\n' "$*" | tee -a "$LOG_FILE"; }

say ""
say "=== pre-push 检查（分支推送）==="
say "日志位置: $LOG_FILE"
say ""

# 判定本次 push 是否涉及 go 文件变更（对齐 pre-commit：无 go 变更跳过全量）。
# 每个推送对分别判定；全部无 go 变更才跳过。
HAS_GO=0
for pair in $PUSH_PAIRS; do
  local_sha="${pair%%|*}"
  remote_sha="${pair##*|}"
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # 新分支：base = merge-base(origin/master, local)；无 origin/master 引用则保守全量
    if git rev-parse --verify origin/master >/dev/null 2>&1; then
      base=$(git merge-base origin/master "$local_sha" 2>/dev/null || echo "")
      [ -n "$base" ] || base=$(git rev-parse origin/master)
    else
      base=""
    fi
    if [ -n "$base" ]; then
      if [ -n "$(git diff --name-only "$base".."$local_sha" -- '*.go' 2>/dev/null)" ]; then
        HAS_GO=1
      fi
    else
      say "（新分支且无法确定 base——保守跑全量）"
      HAS_GO=1
    fi
  else
    if [ -n "$(git diff --name-only "$remote_sha".."$local_sha" -- '*.go' 2>/dev/null)" ]; then
      HAS_GO=1
    fi
  fi
done

if [ "$HAS_GO" -ne 1 ]; then
  say "（本次 push 无 go 文件变更，跳过全量门禁——与 pre-commit 一致）"
  say "=== pre-push 通过（无 go 变更） ==="
  say "（日志: $LOG_FILE）"
  exit 0
fi

# 0. 工作区必须干净（未提交改动会混入 check-format 的 git diff，造成误报）
say "[0/4] 工作区干净检查（git diff + untracked 为空）..."
if [ -n "$(git diff --name-only 2>/dev/null)" ] || [ -n "$(git ls-files --others --exclude-standard 2>/dev/null)" ]; then
  say "✗ 工作区有未提交改动（push 前需先 commit 或 stash）:"
  say "$(git diff --name-only | head -20)"
  say "$(git ls-files --others --exclude-standard | head -20)"
  exit 1
fi
say "工作区干净"

# 1. make check-format（验证 HEAD 格式化干净：go fix + addlicense + gofmt 后无残留）。
#    与 CI check-format job 对齐：fmt-all 是修改型，check-format 是验证型（git diff 必须空）。
say "[1/4] make check-format（go fix + addlicense + gofmt 后无未提交改动）..."
if ! make_out=$(make check-format 2>&1); then
  say "✗ make check-format 失败（格式化有残留，请 commit 后重新 push）"
  say "$make_out"
  exit 1
fi
say "make check-format 通过"

# 2. make lint-all（全部子 module golangci-lint）
say "[2/4] make lint-all（全部子 module golangci-lint）..."
if ! make_out=$(make lint-all 2>&1); then
  say "✗ make lint-all 失败（请修复 lint 后重新 push）"
  say "$make_out"
  exit 1
fi
say "make lint-all 通过"

# 3. make check-ci（全量 CI 等价门禁：vet/lint/loopback/notest/archcheck/deadcode/build/test/cover）
say "[3/4] make check-ci（全量 CI 等价门禁：vet/lint/loopback/notest/archcheck/deadcode/build/test/cover）..."
if ! make_out=$(make check-ci 2>&1); then
  say "✗ make check-ci 失败（请修复后重新 push）"
  say "$make_out"
  exit 1
fi
say "make check-ci 通过"

say ""
say "=== pre-push 通过（check-format + lint-all + check-ci 全绿） ==="
say "（日志: $LOG_FILE）"

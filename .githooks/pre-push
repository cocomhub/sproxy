#!/bin/sh
set -e

# ═══════════════════════════════════════════════════════════════════════════════
# pre-push：push 前全量硬门禁（2026-10-02 用户明示）
#
# 保证 push 前跑通：make fmt-all（全量格式化）→ make lint-all（全部子 module
# lint）→ make check-ci（全量 CI 等价门禁：vet/lint/check-loopback/notest/
# archcheck/deadcode/build/test-cover/cover-check/test-all/build-all）。
#
# 与 pre-commit（增量轻量检查）互补：pre-commit 秒级兜本地，pre-push 全量兜
# push。CI 仍会再跑等价门禁（Lint/Test job），pre-push 只是前置减速带，不是
# 豁免依据；绝对禁止用 --no-verify 绕过（绕过只推迟到 CI，不豁免）。
#
# 输出落盘：build/hooks/pre-push.log（任一 make 失败时直接查看该日志定位，
# 无需重新 push 或手动重跑命令）。
#
# 注：只对分支推送（refs/heads/*）触发；tag 推送不跑全量（tag 无工作树变更）。
# ═══════════════════════════════════════════════════════════════════════════════

# pre-push 的 stdin 为：<local ref> <local sha> <remote ref> <remote sha>，一行一推送。
# 判断是否涉及分支推送（tag 推送放行）。
BRANCH_PUSH=0
while IFS= read -r line; do
  [ -z "$line" ] && continue
  local_ref=$(echo "$line" | awk '{print $1}')
  case "$local_ref" in
    refs/heads/*) BRANCH_PUSH=1 ;;
    *) : ;;
  esac
done

if [ "$BRANCH_PUSH" -ne 1 ]; then
  echo "=== pre-push：本次仅 tag/非分支推送，跳过全量门禁 ==="
  exit 0
fi

echo "=== pre-push 全量门禁（push 前必须全绿）==="
TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL"

# 日志落盘：build/hooks/<hook>.log（build/ 为 git 忽略产物目录，与 coverage 同级）
LOG_DIR="$TOPLEVEL/build/hooks"
LOG_FILE="$LOG_DIR/pre-push.log"
mkdir -p "$LOG_DIR"
: > "$LOG_FILE"
# say：实时显示 + 落盘
say() { printf '%s\n' "$*" | tee -a "$LOG_FILE"; }

say ""
say "=== pre-push 全量门禁（push 前必须全绿）==="
say "日志位置: $LOG_FILE"
say ""

# 1. make fmt-all（全量格式化）
say "[1/3] make fmt-all（全量格式化：go fix + addlicense + gofmt，全部 module）..."
make_out=$(make fmt-all 2>&1); make_rc=$?
if [ "$make_rc" -ne 0 ]; then
  say "✗ make fmt-all 失败（请修复格式化后重新 push）"
  say "$make_out"
  exit 1
fi
say "make fmt-all 通过"

# 2. make lint-all（全部子 module golangci-lint）
say "[2/3] make lint-all（全部子 module golangci-lint）..."
make_out=$(make lint-all 2>&1); make_rc=$?
if [ "$make_rc" -ne 0 ]; then
  say "✗ make lint-all 失败（请修复 lint 后重新 push）"
  say "$make_out"
  exit 1
fi
say "make lint-all 通过"

# 3. make check-ci（全量 CI 等价门禁）
say "[3/3] make check-ci（全量 CI 等价门禁：vet/lint/loopback/notest/archcheck/deadcode/build/test/cover）..."
make_out=$(make check-ci 2>&1); make_rc=$?
if [ "$make_rc" -ne 0 ]; then
  say "✗ make check-ci 失败（请修复后重新 push）"
  say "$make_out"
  exit 1
fi
say "make check-ci 通过"

say ""
say "=== pre-push 通过（fmt-all + lint-all + check-ci 全绿） ==="
say "（日志: $LOG_FILE）"
